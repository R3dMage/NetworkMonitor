# Copy to .env and set the router host/user before collecting.
ROUTER_HOST=
ROUTER_SSH_PORT=22
ROUTER_SSH_USERNAME=
ROUTER_SSH_KEY_FILE=/run/secrets/router_key
ROUTER_SSH_KEY_PASSPHRASE_FILE=
ROUTER_SSH_KNOWN_HOSTS_FILE=/run/secrets/known_hosts
ROUTER_DB_PATH=/jffs/.sys/WebHistory/WebHistory.db
# Some Merlin installations use /opt/bin/sqlite3.
ROUTER_SQLITE_BIN=sqlite3
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_COMMAND_TIMEOUT_SECONDS=120

# Five numeric cron fields. Quotes keep spaces intact.
SCRAPE_CRON="*/5 * * * *"
SCHEDULE_TIMEZONE=UTC
SAFETY_DELAY_SECONDS=300

DATABASE_BACKEND=sqlite
DATABASE_PATH=/data/network_history.db
DATABASE_URL=
TZ=America/New_York

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Read-only HTTP API defaults and bounds.
API_DEFAULT_WINDOW_DAYS=7
API_MAX_RANGE_DAYS=31
API_DEFAULT_PAGE_SIZE=500
API_MAX_PAGE_SIZE=2000

# Disposable operational logs, separate from collected history.
REQUEST_LOG_PATH=/data/request_log.db
REQUEST_LOG_MAX_DISPLAY=1000
